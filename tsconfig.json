{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting - Temporarily disable strict checks */
    "strict": false, // Disable all strict type-checking
    "noUnusedLocals": false, // Allow unused locals
    "noUnusedParameters": false, // Allow unused parameters
    "noFallthroughCasesInSwitch": false, // Allow fallthrough cases in switch statements
    "noImplicitAny": false, // Allow implicit 'any' types

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}